<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.example.gamerecom.dao.User_infoDao">

<!--    <select id="findByUsername" resultType="com.example.gamerecom.entity.Admin_info">-->
<!--        select * from user_info where name = #{username}-->
<!--    </select>-->
    <select id="findByUsername" resultType="com.example.gamerecom.vo.UserInfoVo">
        select * from user_info where name = #{username}
    </select>
    <select id="findByName" resultType="com.example.gamerecom.vo.UserInfoVo">
        select * from user_info where 1=1
        <if test="name != null and name !='' and name !='all'">
            and name like concat('%',#{name},'%')
        </if>
        order by id desc
    </select>
    <select id="count" resultType="java.lang.Integer">
        select count(id) from user_info
    </select>
</mapper>