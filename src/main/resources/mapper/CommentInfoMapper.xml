<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.gamerecom.dao.Comment_infoDao">


    <select id="findByContent" resultType="com.example.gamerecom.entity.Comment_info">
        select a.*,b.name userName,c.name as gamesName from comment_info a
        <if test="level!=null and level ==1">
            left join admin_info b on a.userId=b.id
        </if>
        <if test="level!=null and level ==2">
            left join user_info b on a.userId=b.id
        </if>
        left join games_info c on a.gamesId=c.id
        where 1=1
        <if test="content!=null and content!='all' and content!=''">
            and content like concat('%',#{content},'%')
        </if>
    </select>

    <select id="findByGamesId" resultType="com.example.gamerecom.entity.Comment_info">
        select * from comment_info where gamesId = #{gamesId}
    </select>
    <select id="getCommentInfoByUserIdIn" resultType="com.example.gamerecom.entity.Comment_info">
        SELECT * FROM comment_info
        WHERE userId IN <foreach item='userId' collection='ratedUserIds' open='(' separator=',' close=')'>#{userId}</foreach>
    </select>

</mapper>